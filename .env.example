# PostgreSQL connection string (required)
DATABASE_URL=postgres://user:password@host:5432/pawffee
# Set to "true" for most managed Postgres providers (Supabase, Neon, Render, RDS with SSL)
PGSSL=true

# Secret used to sign admin session cookies — set a long random value in production
SESSION_SECRET=change-me

# S3-compatible object storage for recipe images (required in production;
# without it, uploads fall back to the local filesystem, which is fine for
# `npm run dev` but is NOT persistent on most hosting platforms)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# Used once by `npm run seed` to create the first admin account
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me
