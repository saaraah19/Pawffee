# PostgreSQL connection string (required)
DATABASE_URL=postgres://user:password@host:5432/pawffee
# Set to "true" for most managed Postgres providers (Supabase, Neon, Render, RDS with SSL)
PGSSL=true

# Secret used to sign admin session cookies. Set a long random value in production
SESSION_SECRET=change-me

# Image storage: pick ONE of these two options. Cloudinary is checked first
# if both are set.

# Option A: Cloudinary (recommended if you already use it)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pawffee/recipes

# Option B: any S3-compatible bucket (AWS S3, R2, Spaces, Supabase, MinIO)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# If neither is set, uploads fall back to the local filesystem, which is
# fine for `npm run dev` but is NOT persistent on most hosting platforms.

# Used once by `npm run seed` to create the first admin account
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me